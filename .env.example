# Copy to .env and fill in. .env is ignored by git.
POSTGRES_PASSWORD=change-me
# Declared in the User-Agent of every request to arXiv and Hacker News.
CONTACT_EMAIL=
# Used by the question-answering step only. Set at least one; with both, the other is the fallback.
GROQ_API_KEY=
GEMINI_API_KEY=
# Which one answers first: groq (default) or gemini.
# LLM_PROVIDER=groq
# GROQ_MODEL=qwen/qwen3.8-27b
# Optional. Uncomment to use another model.
# GEMINI_MODEL=gemini-3.6-flash
# How Chat finds articles: hybrid (default), dense or bm25.
# RETRIEVAL_MODE=hybrid
